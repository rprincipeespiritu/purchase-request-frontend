
<mvc:View
    controllerName="com.portfolio.purchase.purchaserequestfrontend.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="page"
        title="Gestión de Solicitudes de Compra">

        <content>

            <VBox class="sapUiResponsiveContentPadding">

                <OverflowToolbar>

                    <Title
                        text="Solicitudes de compra"
                        level="H2" />

                    <ToolbarSpacer />

                    <Button
                        text="Nueva solicitud"
                        icon="sap-icon://add"
                        type="Emphasized"
                        visible="{ui>/isRequester}"
                        press=".onCreateRequest" />

                </OverflowToolbar>

                <OverflowToolbar>

                    <SearchField
                        id="searchField"
                        width="100%"
                        placeholder="Buscar por número de solicitud"
                        liveChange=".onSearch" />

                    <ToolbarSpacer />

                    <Label
                        text="Estado:"
                        visible="{ui>/isApprover}" />

                    <Select
                        id="statusSelect"
                        width="11rem"
                        visible="{ui>/isApprover}"
                        selectedKey="{ui>/statusFilter}"
                        change=".onStatusChange">

                        <core:Item
                            key="SUBMITTED"
                            text="Pendientes" />

                        <core:Item
                            key="APPROVED"
                            text="Aprobadas" />

                        <core:Item
                            key="REJECTED"
                            text="Rechazadas" />

                        <core:Item
                            key="ALL"
                            text="Todas" />

                    </Select>

                </OverflowToolbar>

                <Table
                    id="requestsTable"
                    growing="true"
                    growingThreshold="10"
                    autoPopinMode="true"
                    noDataText="No se encontraron solicitudes"
                    items="{/PurchaseRequests}">

                    <columns>

                        <Column importance="High">
                            <Text text="N° Solicitud" />
                        </Column>

                        <Column importance="Medium">
                            <Text text="Fecha" />
                        </Column>

                        <Column importance="High">
                            <Text text="Justificación" />
                        </Column>

                        <Column importance="High">
                            <Text text="Estado" />
                        </Column>

                        <Column
                            importance="High"
                            hAlign="End">
                            <Text text="Importe" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            type="Navigation"
                            press=".onNavDetail">

                            <cells>

                                <ObjectIdentifier
                                    title="{requestNumber}" />

                                <Text text="{requestDate}" />

                                <Text
                                    text="{justification}"
                                    wrapping="true" />

                                <ObjectStatus
                                    text="{
                                        path: 'status',
                                        formatter: '.formatStatusText'
                                    }"
                                    state="{
                                        path: 'status',
                                        formatter: '.formatStatusState'
                                    }" />

                                <ObjectNumber
                                    number="{totalAmount}"
                                    unit="PEN" />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>
